{
  "/": {
    "script" : "recorded",
    "methods": ["get", "put"],
    "types"  : ["json"]
  },

  "/:id": {
    "script" : "recorded-program",
    "methods": ["get", "delete"],
    "types"  : ["json"]
  },

  "/:id/file": {
    "script" : "recorded-program-file",
    "methods": ["get", "delete"],
    "types"  : ["json", "m2ts"]
  },

  "/:id/preview": {
    "script" : "recorded-program-preview",
    "methods": ["get"],
    "types"  : ["png", "jpg", "txt"]
  },

  "/:id/watch": {
    "script" : "recorded-program-watch",
    "methods": ["get", "head"],
    "types"  : ["mp4", "xspf", "m2ts"]
  },

  "/:id/watch-hls": {
    "script" : "recorded-program-watch-hls",
    "methods": ["get"],
    "types"  : ["json"]
  },

  "/:id/watch-hls/:session": {
    "script" : "recorded-program-watch-hls-session",
    "methods": ["delete"],
    "types"  : ["json"]
  },

  "/:id/watch-hls/:session/:asset": {
    "script" : "recorded-program-watch-hls-asset",
    "methods": ["get", "head"],
    "types"  : ["m3u8", "mp4", "m4s"]
  }
}
