{
  "mirakurunPath": "http+unix://%2Fvar%2Frun%2Fmirakurun.sock/",
  "wuiOpenServer": true,
  "wuiOpenPort": 20772,

  "recordedDir": "./recorded/",
  "recordedDirs": [],

  "storageLowSpaceWarningThresholdMB": 512000,
  "storageLowSpaceWarningIntervalMinutes": 1440,
  "storageLowSpaceThresholdMB": 30720,
  "storageLowSpaceAction": "stop-new",
  "storageLowSpaceCriticalNotifyIntervalMinutes": 60,

  "recordedFormat": "<fulltitle2> <channel-code>[<date:yyyy-mm-dd HHMM>].ts",
  "recordedNameReplaceEnclosingCharacters": true,
  "normalizationForm": "NFKC",
  "epgTitleHalfWidthEnabled": true,
  "bangumiEnabled": false,
  "wikipediaEnabled": false,
  "wikipediaStartYear": 2000
}
