  "scripts": {
    "test": "node --test --test-isolation=none --test-concurrency=1 --test-reporter=spec test/*.test.js",
    "check": "find api common/lib lib test -type f -name '*.js' -exec node --check {} \\; && find . -maxdepth 1 -type f -name 'app-*.js' -exec node --check {} \\; && find next-web -type f -name '*.js' ! -path 'next-web/sample/*' ! -path 'next-web/lib/mpeg2toh264/*' -exec sh -c 'for file do node --input-type=module --check < \"$file\" || { echo \"Syntax check failed: $file\" >&2; exit 1; }; done' sh {} +"
  },
  "engines": {
    "node": "^26.13.0",
    "npm": "^11.19.0"
  },
  "allowScripts": {
    "core-js": false,
    "mirakurun": false
  },
  "overrides": {
    "mirakurun": {
      "glob": "14.0.3",
      "uuid": "11.1.1"
    }
  }
