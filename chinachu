installer_step () {
  printf '\n────────────────────────────────\n[%s/%s] %s\n────────────────────────────────\n' "$1" "$2" "$3"
}

installer_success () {
  printf '      %s✓%s %s\n' "$INSTALLER_GREEN" "$INSTALLER_RESET" "$1"
}

installer_warning () {
  printf '%sWARNING:%s %s\n' "$INSTALLER_YELLOW" "$INSTALLER_RESET" "$1" >&2
}

installer_error () {
  printf '%sERROR:%s %s\n' "$INSTALLER_RED" "$INSTALLER_RESET" "$1" >&2
  exit 1
}

path_exists () {
  [ -e "$1" ] || [ -L "$1" ]
}

resolve_bootstrap_node () {
  if [ -x "$NODE_PATH" ]; then
    BOOTSTRAP_NODE_COMMAND="$NODE_PATH"
  else
    BOOTSTRAP_NODE_COMMAND=$(command -v node) || return 1
  fi

  [ -x "$BOOTSTRAP_NODE_COMMAND" ] || installer_error "Node.js is required for runtime bootstrap."
}

detect_installer_user () {
  local candidate=""

  if [ "$(id -u)" -eq 0 ]; then
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ] && id "$SUDO_USER" > /dev/null 2>&1; then
      candidate="$SUDO_USER"
    elif [ -n "$PKEXEC_UID" ] && candidate=$(id -un "$PKEXEC_UID" 2>/dev/null) && [ "$candidate" != "root" ]; then
      :
    else
      candidate=$(id -un) || return 1
    fi
  else
    candidate=$(id -un) || return 1
  fi

  printf '%s\n' "$candidate"
}

set_new_path_owner () {
  local target="$1"

  if [ "$(id -u)" -eq 0 ] && [ "$BOOTSTRAP_RUNTIME_USER" != "root" ]; then
    chown -- "$BOOTSTRAP_RUNTIME_USER" "$target" || return 1
  fi
}

create_config_if_missing () {
  local installer_user installer_group

  if path_exists config.json; then
    return 0
  fi

  [ -f config.sample.json ] || installer_error "config.sample.json is missing."
  installer_user=$(detect_installer_user) || installer_error "Could not determine the installer user."
  installer_group=$(id -gn "$installer_user" 2>/dev/null) ||
    installer_group=$(id -g "$installer_user" 2>/dev/null) ||
    installer_error "Could not determine the installer user's primary group."

  "$BOOTSTRAP_NODE_COMMAND" -e '
    const fs = require("fs");
    const source = process.argv[1];
    const target = process.argv[2];
    const uid = process.argv[3];
    const gid = process.argv[4];
    const temporary = target + ".tmp." + process.pid;
    let config;
    try {
      config = JSON.parse(fs.readFileSync(source, "utf8"));
      config.uid = uid;
      config.gid = gid;
      fs.writeFileSync(temporary, JSON.stringify(config, null, 2) + "\n");
      fs.linkSync(temporary, target);
    } finally {
      try { fs.unlinkSync(temporary); } catch (_) {}
    }
  ' config.sample.json config.json "$installer_user" "$installer_group" || installer_error "Could not create config.json."

  BOOTSTRAP_RUNTIME_USER="$installer_user"
  set_new_path_owner config.json || installer_error "Could not set config.json owner."
  printf 'created: config.json (uid=%s, gid=%s)\n' "$installer_user" "$installer_group"
}

resolve_runtime_user () {
  local configured_uid configured_gid

  if [ -n "$BOOTSTRAP_RUNTIME_USER_OVERRIDE" ]; then
    BOOTSTRAP_RUNTIME_USER=$(id -un "$BOOTSTRAP_RUNTIME_USER_OVERRIDE" 2>/dev/null) ||
      installer_error "runtime user override does not identify a local user: $BOOTSTRAP_RUNTIME_USER_OVERRIDE"
    return 0
  fi

  if [ "$(id -u)" -ne 0 ]; then
    BOOTSTRAP_RUNTIME_USER=$(id -un) || return 1
    return 0
  fi

  configured_uid=$("$BOOTSTRAP_NODE_COMMAND" -e '
    const config = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    if (typeof config.uid === "string" || typeof config.uid === "number") process.stdout.write(String(config.uid));
  ' config.json) || return 1

  [ -n "$configured_uid" ] || installer_error "config.json uid is required when installer runs as root."
  BOOTSTRAP_RUNTIME_USER=$(id -un "$configured_uid" 2>/dev/null) || installer_error "config.json uid does not identify a local user: $configured_uid"

  configured_gid=$("$BOOTSTRAP_NODE_COMMAND" -e '
    const config = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    const gid = typeof config.gid === "string" || typeof config.gid === "number" ? config.gid : "video";
    process.stdout.write(String(gid));
  ' config.json) || return 1

  getent group "$configured_gid" > /dev/null 2>&1 || installer_error "config.json gid does not identify a local group: $configured_gid"
}

load_bootstrap_config () {
  BOOTSTRAP_RECORDED_DIR=$("$BOOTSTRAP_NODE_COMMAND" -e '
    const config = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    if (!config || Array.isArray(config) || typeof config !== "object") process.exit(2);
    if (typeof config.recordedDir !== "string" || config.recordedDir.trim() === "") process.exit(3);
    process.stdout.write(config.recordedDir);
  ' config.json) || installer_error "config.json must contain an object with a non-empty recordedDir."
}

create_copy_if_missing () {
  local source="$1"
  local target="$2"

  if path_exists "$target"; then
    return 0
  fi

  [ -f "$source" ] || installer_error "$source is missing."
  "$BOOTSTRAP_NODE_COMMAND" -e '
    const fs = require("fs");
    fs.copyFileSync(process.argv[1], process.argv[2], fs.constants.COPYFILE_EXCL);
  ' "$source" "$target" || installer_error "Could not create $target."
  set_new_path_owner "$target" || installer_error "Could not set $target owner."
  printf 'created: %s\n' "$target"
}

ensure_runtime_dir () {
  local target="$1"
  local created=false

  if ! [ -d "$target" ]; then
    if path_exists "$target"; then
      installer_error "$target exists but is not a directory."
      return 1
    fi
    created=true
  fi

  ensure_dir "$target" || return 1
  if [ "$created" = true ]; then
    set_new_path_owner "$target" || installer_error "Could not set $target owner."
    printf 'created: %s/\n' "${target%/}"
  fi
}

create_json_array_if_missing () {
  local target="$1"

  if path_exists "$target"; then
    return 0
  fi

  ( set -o noclobber; printf '[]\n' > "$target" ) 2>/dev/null || installer_error "Could not create $target."
  set_new_path_owner "$target" || installer_error "Could not set $target owner."
  printf 'created: %s\n' "$target"
}

capture_bootstrap_existing_files () {
  local file checksum

  BOOTSTRAP_EXISTING_CHECKSUMS=()
  for file in config.json rules.json \
    data/reserves.json data/reserves2.json data/recording.json \
    data/recorded.json data/schedule.json data/match.json
  do
    if [ -f "$file" ]; then
      checksum=$(cksum < "$file") || return 1
      BOOTSTRAP_EXISTING_CHECKSUMS["$file"]="$checksum"
    fi
  done
}

chinachu_runtime_bootstrap () {
  local file

  resolve_bootstrap_node || return 1
  capture_bootstrap_existing_files || installer_error "Could not capture existing runtime file checksums."
  create_config_if_missing || return 1
  load_bootstrap_config || return 1
  resolve_runtime_user || return 1
  create_copy_if_missing rules.sample.json rules.json || return 1
  ensure_runtime_dir data || return 1
  ensure_runtime_dir log || return 1

  for file in reserves reserves2 recording recorded schedule match
  do
    create_json_array_if_missing "data/${file}.json" || return 1
  done

  ensure_runtime_dir "$BOOTSTRAP_RECORDED_DIR" || return 1
}

test_path_as_runtime_user () {
  local flag="$1"
  local target="$2"

  if [ "$(id -u)" -eq 0 ] && [ "$BOOTSTRAP_RUNTIME_USER" != "root" ]; then
    command -v runuser > /dev/null 2>&1 || installer_error "runuser is required to verify permissions for $BOOTSTRAP_RUNTIME_USER."
    runuser -u "$BOOTSTRAP_RUNTIME_USER" -- test "$flag" "$target"
  else
    test "$flag" "$target"
  fi
}

verify_runtime_permissions () {
  local recorded_dir target flag

  recorded_dir=$("$BOOTSTRAP_NODE_COMMAND" -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).recordedDir)' config.json) || return 1

  for target in data log "$recorded_dir"
  do
    for flag in -r -w -x
    do
      test_path_as_runtime_user "$flag" "$target" || installer_error "$BOOTSTRAP_RUNTIME_USER cannot use $target ($flag)."
    done
  done

  for target in config.json rules.json \
    data/reserves.json data/reserves2.json data/recording.json \
    data/recorded.json data/schedule.json data/match.json
  do
    test_path_as_runtime_user -r "$target" || installer_error "$BOOTSTRAP_RUNTIME_USER cannot read $target."
    test_path_as_runtime_user -w "$target" || installer_error "$BOOTSTRAP_RUNTIME_USER cannot write $target."
  done
}

verify_bootstrap_existing_files () {
  local file checksum

  for file in "${!BOOTSTRAP_EXISTING_CHECKSUMS[@]}"
  do
    [ -f "$file" ] || installer_error "Existing runtime file disappeared: $file"
    checksum=$(cksum < "$file") || return 1
    [ "$checksum" = "${BOOTSTRAP_EXISTING_CHECKSUMS[$file]}" ] || installer_error "Existing runtime file changed during bootstrap: $file"
  done
}

chinachu_installer_verify () {
  resolve_bootstrap_node || return 1
  [ -x "$NODE_PATH" ] || installer_error "Nave Node.js is not executable: $NODE_PATH"
  chinachu_installer_runtime_ready || installer_error "Runtime validation failed (expected Node.js v$NODE_VER and npm ^11.19.0)."
  [ -x "$NPM_PATH" ] || installer_error "Nave npm is not executable: $NPM_PATH"
  PATH="$(dirname -- "$NODE_PATH"):$PATH" "$NPM_PATH" --version > /dev/null || installer_error "Nave npm could not be executed."
  chinachu_installer_node_ready || installer_error "Nave runtime links do not match the target Node.js/npm."
  chinachu_installer_dependencies_ready || installer_error "Dependencies do not match the target Node.js ABI or package lock."

  verify_runtime_ffmpeg || installer_error "System ffmpeg and ffprobe verification failed."
  print_ffmpeg_commands "Runtime"

  "$NODE_PATH" -e '
    const fs = require("fs");
    const config = JSON.parse(fs.readFileSync("config.json", "utf8"));
    if (!config || Array.isArray(config) || typeof config !== "object") throw new Error("config.json must contain an object");
    const rules = JSON.parse(fs.readFileSync("rules.json", "utf8"));
    if (!Array.isArray(rules)) throw new Error("rules.json must contain an array");
    for (const file of ["reserves", "reserves2", "recording", "recorded", "schedule", "match"]) {
      const data = JSON.parse(fs.readFileSync("data/" + file + ".json", "utf8"));
      if (!Array.isArray(data)) throw new Error("data/" + file + ".json must contain an array");
    }
  ' || installer_error "Configuration or runtime JSON validation failed."

  resolve_runtime_user || return 1
  verify_runtime_permissions || return 1
  verify_bootstrap_existing_files || return 1
}

ensure_dir () {
  if ! [ -d "$1" ]; then
    mkdir -p -- "$1" || fail "couldn't create $1"
  fi
}

remove_dir () {
  if [ -d "$1" ]; then
    rm -rf -- "$1" || fail "couldn't remove $1"
    echo "removed \`$1'"
  fi
}

fail () {
  echo "$@" >&2
  exit 1
}

main "$@"
