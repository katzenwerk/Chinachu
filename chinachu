chinachu_reserve () {
  if [ ! "$1" ]; then
    fail "Usage: reserve <pgid>"
  fi

  node app-cli.js -mode reserve -id "$@" || fail "couldn't reserve $1"

  while [ 1 ]; do
    echo -n "Run a scheduler [Y/n]? "
    read line
    case ${line:-y} in
      [yY])
        chinachu_update
        return $?
        ;;
      [nN])
        echo "Ok." && return 0
        ;;
    esac
  done
}

