chinachu_run_scheduler_once () {
  node app-scheduler.js "$@" > /dev/stdout 2>&1 | tee -a ./log/scheduler
  return ${PIPESTATUS[0]}
}

chinachu_update () {
  local status

  chinachu_run_scheduler_once "$@"
  status=$?

  if [ "$status" -eq 75 ]; then
    echo "Scheduler reservation update conflict; retrying once with the latest reserves.json." >&2
    chinachu_run_scheduler_once "$@"
    status=$?
  fi

  return "$status"
}

