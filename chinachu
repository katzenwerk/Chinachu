#!/bin/bash

# Chinachu-CLI
# ------------
#
#   Usage:
#
#     ./chinachu <cmd> ...
#

if [ -z "$BASH" ]; then
  echo "Chinachu-CLI only works with bash.  Sorry." >&2
  exit 1
fi

shopt -s extglob

# variables
NODE_VER=26.13.0

declare -A BOOTSTRAP_EXISTING_CHECKSUMS=()
BOOTSTRAP_NODE_COMMAND=""
BOOTSTRAP_RUNTIME_USER=""
BOOTSTRAP_RECORDED_DIR=""
FFMPEG_COMMAND=""
FFPROBE_COMMAND=""
FFMPEG_VERSION=""
FFPROBE_VERSION=""
FFMPEG_LOCAL_STATE=""

if [ -t 1 ]; then
  INSTALLER_GREEN=$'\033[32m'
  INSTALLER_RED=$'\033[31m'
  INSTALLER_YELLOW=$'\033[33m'
  INSTALLER_RESET=$'\033[0m'
else
  INSTALLER_GREEN=""
  INSTALLER_RED=""
  INSTALLER_YELLOW=""
  INSTALLER_RESET=""
fi

main () {
  local SELF_PATH DIR SYM
  # get the absolute path of the executable
  SELF_PATH="$0"
  if [ "${SELF_PATH:0:1}" != "." ] && [ "${SELF_PATH:0:1}" != "/" ]; then
    SELF_PATH=./"$SELF_PATH"
  fi
  SELF_PATH=$( cd -P -- "$(dirname -- "$SELF_PATH")" \
            && pwd -P \
            ) && SELF_PATH=$SELF_PATH/$(basename -- "$0")

  # resolve symlinks
  while [ -h "$SELF_PATH" ]; do
    DIR=$(dirname -- "$SELF_PATH")
    SYM=$(readlink -- "$SELF_PATH")
    SELF_PATH=$( cd -- "$DIR" \
              && cd -- $(dirname -- "$SYM") \
              && pwd \
              )/$(basename -- "$SYM")
  done

  # path
  CHINACHU_DIR=$(dirname -- "$SELF_PATH")
  NAVE_DIR=${CHINACHU_DIR}/.nave
  NODE_PATH=${NAVE_DIR}/installed/${NODE_VER}/bin/node
  NPM_PATH=${NAVE_DIR}/installed/${NODE_VER}/bin/npm
  USR_DIR=${CHINACHU_DIR}/usr

  export PATH=${NAVE_DIR}:${NAVE_DIR}/installed/${NODE_VER}/bin:$USR_DIR/bin:$PATH
  export LD_LIBRARY_PATH=$USR_DIR/lib:$LD_LIBRARY_PATH
  export PKG_CONFIG_PATH=$USR_DIR/lib/pkgconfig

  cd $CHINACHU_DIR

  export CHINACHU_DIR
  export NAVE_DIR

  local cmd="$1"
  shift
  case $cmd in
    runtime-check ) cmd=chinachu_runtime_check ;;
    installer | upgrade | updater | service | update | search | \
    reserve | unreserve | skip | unskip | stop | \
    rule | enrule | disrule | rmrule | \
    rules | reserves | recording | recorded | \
    cleanup | cleaner | ircbot | auth | test )
      cmd="chinachu_$cmd"
      ;;
    * )
      cmd="chinachu_help"
      ;;
  esac
  "$cmd" "$@"
  exit $?
}

chinachu_installer () {
  ensure_dir "$USR_DIR"
  ensure_dir "$USR_DIR/src"
  ensure_dir "$USR_DIR/bin"

  export CFLAGS="-O2 -w -pipe -march=native"
  export CXXFLAGS="-O2 -w -pipe -march=native"
  export MAKEFLAGS="-j $((`grep processor /proc/cpuinfo | wc -l` + 1)) -l 3"

  local choice="$1"

  if [ -z "$choice" ]; then
    printf '\nChinachu Installer\n────────────────────────────────\n\n'
    printf '1) Auto (Full)\n'
    printf '2) Node.js\n'
    printf '3) Dependencies\n'
    printf '4) Runtime Bootstrap\n'
    printf '5) Verify\n'
    printf '6) PM2 Service Setup\n'
    printf '0) Exit\n'
    [ -t 0 ] || { installer_error "非対話実行ではinstaller項目を引数で指定してください。"; return 1; }
    read -r -p '> ' choice
  fi

  case "$choice" in
    1 | auto | full ) chinachu_installer_auto_full "$2" ;;
    2 | node ) chinachu_installer_node "$2" ;;
    node-prepare ) chinachu_installer_node_prepare "${2:-$NODE_VER}" "$3" ;;
    3 | dependencies | modules ) chinachu_installer_node_modules "$2" ;;
    dependencies-prepare ) chinachu_installer_dependencies_prepare ;;
    dependencies-publish ) chinachu_installer_dependencies_publish "$2" ;;
    ffmpeg ) chinachu_installer_ffmpeg ;;
    4 | bootstrap | runtime ) chinachu_runtime_bootstrap ;;
    5 | verify ) chinachu_installer_verify ;;
    6 | service | pm2 ) chinachu_installer_pm2_service "$2" ;;
    0 | exit | quit ) return 0 ;;
    * )
      installer_error "installer項目を選択できませんでした: $choice"
      return 1
      ;;
  esac
}

chinachu_installer_auto_full () {
  installer_step 1 6 "FFmpeg"
  chinachu_installer_ffmpeg || installer_error "FFmpeg installation failed."
  installer_success "Ready"

  installer_step 2 6 "Node.js"
  if chinachu_installer_node_ready; then
    printf 'Using existing Nave Node.js v%s.\n' "$NODE_VER"
  else
    chinachu_installer_node_prepare "$NODE_VER" "$1" || installer_error "Node.js preparation failed."
  fi
  installer_success "v${NODE_VER}"

  installer_step 3 6 "Dependencies"
  if chinachu_installer_dependencies_ready; then
    printf 'Existing node_modules satisfies package-lock.json.\n'
  else
    chinachu_installer_node_modules || installer_error "Dependency installation failed."
  fi
  installer_success "Ready"
  chinachu_installer_node_ready || chinachu_installer_node || installer_error "Node.js activation failed."

  installer_step 4 6 "Runtime Bootstrap"
  chinachu_runtime_bootstrap || installer_error "Runtime bootstrap failed."
  installer_success "Ready"

  installer_step 5 6 "Verify"
  chinachu_installer_verify || installer_error "Installer verification failed."
  installer_success "Passed"

  installer_step 6 6 "PM2 Runtime / Service Setup"
  chinachu_installer_offer_pm2 auto || return 1

  printf '\n%sInstallation completed successfully.%s\n' "$INSTALLER_GREEN" "$INSTALLER_RESET"

  chinachu_auth_setup_hint "${BOOTSTRAP_RUNTIME_USER:-$(id -un)}"

  return 0
}

chinachu_auth_setup_hint () {
  local runtime_user="$1" setup_state

  node app-auth.js _needs-setup >/dev/null 2>&1
  setup_state=$?
  case "$setup_state" in
    0)
      printf '\n［任意］WUIログイン認証（Auth・2FA）\n'
      printf 'ログイン認証を利用する場合は、Chinachu実行ユーザー（%s）で以下を実行してください。\n\n' "$runtime_user"
      printf '  cd %q\n' "$CHINACHU_DIR"
      printf '  ./chinachu auth setup\n\n'
      printf '登録後、WUIの「設定 → ログイン認証」からAuthを有効化できます。\n'
      printf '2FAも同じ画面で設定できます。\n'
      ;;
    1)
      ;;
    *)
      installer_warning "WUIログイン認証の登録状態を確認できなかったため、初期登録案内は表示しません。"
      ;;
  esac
}

chinachu_installer_offer_pm2 () {
  . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
  service_setup_installer_offer "$1"
}

chinachu_installer_pm2_service () {
  chinachu_installer_offer_pm2 "${1:-menu}"
}

# Inherit these priorities in download, extraction and any Nave source build.
chinachu_installer_priority_prefix () {
  priority=()
  if command -v nice > /dev/null 2>&1; then priority+=(nice -n 10); fi
  if command -v ionice > /dev/null 2>&1; then priority+=(ionice -c 3); fi
}

chinachu_installer_low_priority () {
  local -a priority=()
  chinachu_installer_priority_prefix
  "${priority[@]}" "$@"
}

# Preparation never changes the active links or an existing runtime directory.
chinachu_installer_node_prepare () {
  local version="${1:-$NODE_VER}" mode="${2:-}" nave_download stage
  case "$mode" in "" | --allow-source-build) ;; *) installer_warning "Unknown Node install option: $mode"; return 1 ;; esac
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  local NODE_VER="$version"
  local NODE_PATH="$NAVE_DIR/installed/$version/bin/node"
  local NPM_PATH="$NAVE_DIR/installed/$version/bin/npm"
  chinachu_installer_runtime_ready && return 0
  if [ -e "$NAVE_DIR/installed/$version" ] || [ -L "$NAVE_DIR/installed/$version" ]; then
    installer_warning "Invalid existing runtime: $NAVE_DIR/installed/$version; inspect it before retrying. No files were removed."
    return 1
  fi
  ensure_dir "$NAVE_DIR" || return 1
  if [ ! -x "$NAVE_DIR/nave.sh" ]; then
    nave_download="$NAVE_DIR/nave.sh.download.$$"
    wget -O "$nave_download" https://raw.githubusercontent.com/isaacs/nave/v3.2.2/nave.sh || { rm -f -- "$nave_download"; return 1; }
    chmod a+x "$nave_download" || { rm -f -- "$nave_download"; return 1; }
    mv -- "$nave_download" "$NAVE_DIR/nave.sh" || return 1
  fi
  stage=$(mktemp -d "$NAVE_DIR/.prepare.XXXXXXXX") || return 1
  if ! chinachu_installer_low_priority env NAVE_DIR="$stage" NAVE_JOBS=1 JOBS=1 MAKEFLAGS=-j1 bash "$CHINACHU_DIR/lib/installer-nave.sh" "$NAVE_DIR/nave.sh" "$version" "$mode" ||
     ! ( NODE_PATH="$stage/installed/$version/bin/node"
         NPM_PATH="$stage/installed/$version/bin/npm"
         chinachu_installer_runtime_ready ); then
    chinachu_installer_low_priority rm -rf -- "$stage"
    return 1
  fi
  ensure_dir "$NAVE_DIR/installed" || return 1
  # -T prevents nesting inside a runtime created by another installer.
  mv -T -- "$stage/installed/$version" "$NAVE_DIR/installed/$version" || { chinachu_installer_low_priority rm -rf -- "$stage"; return 1; }
  chinachu_installer_low_priority rm -rf -- "$stage"
}

chinachu_installer_runtime_ready () {
  local npm_version node_version
  [ -x "$NODE_PATH" ] && [ -x "$NPM_PATH" ] || return 1
  node_version=$("$NODE_PATH" --version 2>&1) || {
    printf 'Node runtime failed: %s\n' "$node_version" >&2
    case "$node_version" in *libatomic*) printf 'Install the distribution libatomic1 runtime package before retrying; no packages were changed.\n' >&2 ;; esac
    return 1
  }
  [ "$node_version" = "v${NODE_VER}" ] || return 1
  npm_version=$(PATH="$(dirname -- "$NODE_PATH"):$PATH" "$NPM_PATH" --version 2>/dev/null) || return 1
  [[ "$npm_version" =~ ^11\.([0-9]+)\.[0-9]+$ ]] || return 1
  (( 10#${BASH_REMATCH[1]} >= 19 ))
}

chinachu_installer_node () {
  local link
  chinachu_installer_require_stopped || return 1
  chinachu_installer_node_prepare "$NODE_VER" "$1" || return 1
  for link in node npm; do
    if [ -e "$NAVE_DIR/$link" ] && [ ! -L "$NAVE_DIR/$link" ]; then
      installer_warning "$NAVE_DIR/$link is not a symlink."
      return 1
    fi
  done
  ln -s "$NODE_PATH" "$NAVE_DIR/node.new.$$" || return 1
  ln -s "$NPM_PATH" "$NAVE_DIR/npm.new.$$" || { rm -f -- "$NAVE_DIR/node.new.$$"; return 1; }
  if mv -Tf -- "$NAVE_DIR/node.new.$$" "$NAVE_DIR/node" &&
     mv -Tf -- "$NAVE_DIR/npm.new.$$" "$NAVE_DIR/npm" && chinachu_installer_node_ready; then
    return 0
  fi
  rm -f -- "$NAVE_DIR/node.new.$$" "$NAVE_DIR/npm.new.$$"
  return 1
}

# Preparation never changes live modules; publication requires stopped applications.
chinachu_installer_dependencies_prepare () {
  local stage
  chinachu_installer_runtime_ready || return 1
  stage=$(mktemp -d "$CHINACHU_DIR/.dependencies.XXXXXXXX") || return 1
  if ! ( cp -- package.json package-lock.json "$stage/" &&
         cp -a -- common "$stage/common" &&
         cd -- "$stage" &&
         chinachu_installer_low_priority env PATH="$(dirname -- "$NODE_PATH"):$PATH" "$NPM_PATH" ci >&2 &&
         "$NODE_PATH" -p 'process.versions.modules' > node_modules/.chinachu-node-abi &&
         chinachu_installer_dependencies_ready ); then
    chinachu_installer_low_priority rm -rf -- "$stage"
    return 1
  fi
  printf '%s\n' "$stage"
}

chinachu_installer_dependencies_publish () {
  local stage="$1"
  case "$stage" in "$CHINACHU_DIR"/.dependencies.*) ;; *) return 1 ;; esac
  [ "$(dirname -- "$stage")" = "$CHINACHU_DIR" ] && [ -d "$stage" ] && [ ! -L "$stage" ] || return 1
  chinachu_installer_require_stopped || return 1
  cmp -s package.json "$stage/package.json" &&
    cmp -s package-lock.json "$stage/package-lock.json" &&
    cmp -s common/package.json "$stage/common/package.json" || {
      installer_warning "Prepared manifests changed; keep the old environment and prepare dependencies again."
      return 1
    }
  ( cd -- "$stage" && chinachu_installer_dependencies_ready ) || return 1
  # The prepared tree has passed all checks; do not retain a copy of old dependencies.
  chinachu_installer_low_priority rm -rf -- node_modules || return 1
  mv -T -- "$stage/node_modules" node_modules || return 1
  chinachu_installer_low_priority rm -rf -- "$stage"
}

chinachu_installer_node_modules () {
  local stage
  chinachu_installer_require_stopped || return 1
  stage=$(chinachu_installer_dependencies_prepare) || return 1
  if ! chinachu_installer_dependencies_publish "$stage"; then
    installer_warning "Dependency publication failed; prepared dependencies: $stage"
    return 1
  fi
}

chinachu_installer_node_ready () {
  chinachu_installer_runtime_ready || return 1
  [ "$(readlink -f -- "$NAVE_DIR/node" 2>/dev/null)" = "$(readlink -f -- "$NODE_PATH" 2>/dev/null)" ] || return 1
  [ "$(readlink -f -- "$NAVE_DIR/npm" 2>/dev/null)" = "$(readlink -f -- "$NPM_PATH" 2>/dev/null)" ]
}

chinachu_installer_dependencies_ready () {
  [ -x "$NODE_PATH" ] && [ -x "$NPM_PATH" ] || return 1
  [ -r package.json ] && [ -r package-lock.json ] && [ -d node_modules ] || return 1
  [ -r node_modules/.chinachu-node-abi ] || return 1
  [ "$(cat node_modules/.chinachu-node-abi)" = "$("$NODE_PATH" -p 'process.versions.modules')" ] || return 1
  chinachu_installer_low_priority env PATH="$(dirname -- "$NODE_PATH"):$PATH" "$NPM_PATH" ls --all > /dev/null || return 1
  "$NODE_PATH" -e '
    const fs = require("fs"), util = require("util");
    const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
    const lock = JSON.parse(fs.readFileSync("package-lock.json", "utf8"));
    const root = lock.packages && lock.packages[""];
    if (!root) process.exit(1);
    for (const field of ["dependencies", "devDependencies", "optionalDependencies"]) {
      if (!util.isDeepStrictEqual(pkg[field] || {}, root[field] || {})) process.exit(1);
    }
  '
}

chinachu_installer_require_stopped () {
  local state=0
  chinachu_application_processes_running || state=$?
  [ "$state" = 1 ] && return 0
  installer_warning "Chinachu is running or its stopped state cannot be verified. Keep runtime links/modules unchanged; verify the selected PM2 manager after recording checks."
  return 1
}

chinachu_application_processes_running () {
  local process cwd command
  for process in /proc/[0-9]*
  do
    cwd=$(readlink -f -- "$process/cwd" 2>/dev/null) || continue
    [ "$cwd" = "$CHINACHU_DIR" ] || continue
    command=$(tr '\0' ' ' < "$process/cmdline" 2>/dev/null) || continue
    case "$command" in
      *app-operator.js* | *app-wui.js* ) return 0 ;;
    esac
  done
  local home pid_file pid
  home=$(getent passwd "$(id -un)" | cut -d: -f6) || return 2
  [ -n "$home" ] || return 2
  for pid_file in "$home"/.pm2/pids/chinachu-operator-*.pid "$home"/.pm2/pids/chinachu-wui-*.pid; do
    [ -e "$pid_file" ] || continue
    [ -r "$pid_file" ] || return 2
    read -r pid < "$pid_file" || [ -n "$pid" ] || return 2
    case "$pid" in "" | *[!0-9]*) return 2 ;; 0) continue ;; esac
    cwd=$(readlink -f -- "/proc/$pid/cwd" 2>/dev/null) || return 2
    [ "$cwd" != "$CHINACHU_DIR" ] || return 0
    return 2 # PID reuse/foreign namespace cannot prove this saved application stopped.
  done
  return 1
}

chinachu_installer_ffmpeg () {
  local system_path

  inspect_repository_ffmpeg
  if [ "$FFMPEG_LOCAL_STATE" = "unknown" ]; then
    installer_warning "Unknown repository-local FFmpeg override detected."
    print_repository_ffmpeg_paths
    printf 'Move or review these files explicitly before rerunning the installer. No files or packages were changed.\n' >&2
    return 1
  fi

  system_path=$(ffmpeg_system_path)
  if ! capture_ffmpeg_commands "$system_path"; then
    printf 'System ffmpeg and ffprobe are required but were not both executable.\n' >&2
    install_system_ffmpeg_package || return 1
    system_path=$(ffmpeg_system_path)
    capture_ffmpeg_commands "$system_path" || {
      installer_warning "ffmpeg or ffprobe is still unavailable after package installation."
      return 1
    }
  fi
  print_ffmpeg_commands "System"

  if [ "$FFMPEG_LOCAL_STATE" = "legacy" ]; then
    printf '\nLegacy bundled FFmpeg 4.1.4 was detected:\n'
    print_repository_ffmpeg_paths
    printf 'The four entries above shadow the verified system FFmpeg and will be removed.\n'
    if ! confirm_installer_action "Remove the legacy bundled FFmpeg and use the system FFmpeg"; then
      printf 'Legacy FFmpeg migration was not approved. No files were changed.\n' >&2
      return 1
    fi
    remove_legacy_ffmpeg || return 1
  fi

  hash -r
  verify_runtime_ffmpeg || return 1

  print_ffmpeg_commands "Runtime"
  echo "ffmpeg --> ready."

  return 0
}

ffmpeg_system_path () {
  local entry local_bin result=""
  local -a entries=()

  local_bin="${USR_DIR%/}/bin"
  IFS=':' read -r -a entries <<< "${PATH:-}"
  for entry in "${entries[@]}"
  do
    [ "${entry%/}" = "$local_bin" ] && continue
    if [ -z "$result" ]; then
      result="$entry"
    else
      result="${result}:$entry"
    fi
  done

  printf '%s\n' "$result"
}

capture_ffmpeg_commands () {
  local lookup_path="$1" output

  hash -r
  FFMPEG_COMMAND=$(PATH="$lookup_path" command -v ffmpeg 2>/dev/null) || return 1
  FFPROBE_COMMAND=$(PATH="$lookup_path" command -v ffprobe 2>/dev/null) || return 1
  [ -x "$FFMPEG_COMMAND" ] || return 1
  [ -x "$FFPROBE_COMMAND" ] || return 1

  output=$("$FFMPEG_COMMAND" -version 2>&1) || return 1
  FFMPEG_VERSION=${output%%$'\n'*}
  [ -n "$FFMPEG_VERSION" ] || return 1

  output=$("$FFPROBE_COMMAND" -version 2>&1) || return 1
  FFPROBE_VERSION=${output%%$'\n'*}
  [ -n "$FFPROBE_VERSION" ] || return 1
}

print_ffmpeg_commands () {
  printf '%s ffmpeg: %s\n  %s\n' "$1" "$FFMPEG_COMMAND" "$FFMPEG_VERSION"
  printf '%s ffprobe: %s\n  %s\n' "$1" "$FFPROBE_COMMAND" "$FFPROBE_VERSION"
}

inspect_repository_ffmpeg () {
  local ffmpeg_path ffprobe_path ffmpeg_output ffprobe_output
  local avconv_target avprobe_target

  ffmpeg_path="$USR_DIR/bin/ffmpeg"
  ffprobe_path="$USR_DIR/bin/ffprobe"
  FFMPEG_LOCAL_STATE="none"

  if ! path_exists "$ffmpeg_path" && ! path_exists "$ffprobe_path"; then
    return 0
  fi

  FFMPEG_LOCAL_STATE="unknown"
  [ -f "$ffmpeg_path" ] && [ ! -L "$ffmpeg_path" ] && [ -x "$ffmpeg_path" ] || return 0
  [ -f "$ffprobe_path" ] && [ ! -L "$ffprobe_path" ] && [ -x "$ffprobe_path" ] || return 0
  [ -L "$USR_DIR/bin/avconv" ] && [ -L "$USR_DIR/bin/avprobe" ] || return 0

  ffmpeg_output=$("$ffmpeg_path" -version 2>/dev/null) || return 0
  ffprobe_output=$("$ffprobe_path" -version 2>/dev/null) || return 0
  case "${ffmpeg_output%%$'\n'*}" in
    "ffmpeg version 4.1.4-static https://johnvansickle.com/ffmpeg/"* ) ;;
    * ) return 0 ;;
  esac
  case "${ffprobe_output%%$'\n'*}" in
    "ffprobe version 4.1.4-static https://johnvansickle.com/ffmpeg/"* ) ;;
    * ) return 0 ;;
  esac

  avconv_target=$(readlink -- "$USR_DIR/bin/avconv") || return 0
  avprobe_target=$(readlink -- "$USR_DIR/bin/avprobe") || return 0
  [ "$avconv_target" = "$ffmpeg_path" ] || return 0
  [ "$avprobe_target" = "$ffprobe_path" ] || return 0

  FFMPEG_LOCAL_STATE="legacy"
}

print_repository_ffmpeg_paths () {
  local name target="$USR_DIR/bin"

  for name in ffmpeg ffprobe avconv avprobe
  do
    if path_exists "$target/$name"; then
      printf '  %s' "$target/$name"
      if [ -L "$target/$name" ]; then
        printf ' -> %s' "$(readlink -- "$target/$name")"
      fi
      printf '\n'
    fi
  done
}

confirm_installer_action () {
  local answer

  [ -t 0 ] || return 1
  read -r -p "$1 [y/N]? " answer || return 1
  case "$answer" in
    y | Y | yes | YES ) return 0 ;;
    * ) return 1 ;;
  esac
}

resolve_apt_commands () {
  local os_id="" os_like="" system_path

  [ -r /etc/os-release ] || return 1
  os_id=$( ( . /etc/os-release; printf '%s' "${ID:-}" ) ) || return 1
  os_like=$( ( . /etc/os-release; printf '%s' "${ID_LIKE:-}" ) ) || return 1
  case " $os_id $os_like " in
    *" linuxmint "* | *" ubuntu "* ) ;;
    * ) return 1 ;;
  esac

  system_path=$(ffmpeg_system_path)
  APT_GET_COMMAND=$(PATH="$system_path" command -v apt-get 2>/dev/null) || return 1
  [ -x "$APT_GET_COMMAND" ] || return 1

  SUDO_COMMAND=""
  if [ "$(id -u)" -ne 0 ]; then
    SUDO_COMMAND=$(PATH="$system_path" command -v sudo 2>/dev/null) || return 1
    [ -x "$SUDO_COMMAND" ] || return 1
  fi
}

install_system_ffmpeg_package () {
  if ! resolve_apt_commands; then
    printf 'Automatic installation is available only on Ubuntu/Linux Mint with apt-get' >&2
    printf ' and sudo when running as a normal user.\n' >&2
    if [ "$(id -u)" -eq 0 ]; then
      printf 'Install the FFmpeg package, then rerun this stage: apt-get install -- ffmpeg\n' >&2
    else
      printf 'Install the FFmpeg package, then rerun this stage: sudo -- apt-get install -- ffmpeg\n' >&2
    fi
    return 1
  fi

  if [ "$(id -u)" -eq 0 ]; then
    printf 'Required command: apt-get install -- ffmpeg\n'
  else
    printf 'Required command: sudo -- apt-get install -- ffmpeg\n'
  fi

  if ! confirm_installer_action "Install the system FFmpeg package"; then
    printf 'FFmpeg package installation was not approved or the installer is non-interactive.\n' >&2
    return 1
  fi

  if [ "$(id -u)" -eq 0 ]; then
    "$APT_GET_COMMAND" install -- ffmpeg || return 1
  else
    "$SUDO_COMMAND" -- "$APT_GET_COMMAND" install -- ffmpeg || return 1
  fi
}

remove_legacy_ffmpeg () {
  inspect_repository_ffmpeg
  if [ "$FFMPEG_LOCAL_STATE" != "legacy" ]; then
    installer_warning "Repository-local FFmpeg changed before removal; no files were removed."
    print_repository_ffmpeg_paths
    return 1
  fi

  rm -- \
    "$USR_DIR/bin/ffmpeg" \
    "$USR_DIR/bin/ffprobe" \
    "$USR_DIR/bin/avconv" \
    "$USR_DIR/bin/avprobe"
}

verify_runtime_ffmpeg () {
  if path_exists "$USR_DIR/bin/ffmpeg" || path_exists "$USR_DIR/bin/ffprobe"; then
    installer_warning "Repository-local ffmpeg or ffprobe still shadows the system commands."
    print_repository_ffmpeg_paths
    return 1
  fi

  capture_ffmpeg_commands "$PATH"
}

chinachu_updater () {
  chinachu_upgrade "$@"
}

upgrade_error () {
  printf '%sERROR:%s %s\n' "$INSTALLER_RED" "$INSTALLER_RESET" "$1" >&2
  return 1
}

upgrade_as_user () {
  local user_home
  if [ "$(id -un)" = "$UPGRADE_USER" ]; then
    "$@"
  else
    user_home=$(getent passwd "$UPGRADE_USER" | awk -F: 'NR == 1 { print $6 }') || return 1
    [ -n "$user_home" ] || return 1
    runuser -u "$UPGRADE_USER" -- env HOME="$user_home" USER="$UPGRADE_USER" LOGNAME="$UPGRADE_USER" "$@"
  fi
}

upgrade_git () {
  upgrade_as_user git -C "$CHINACHU_DIR" "$@"
}

upgrade_verify_repository_owner () {
  local user_uid repository_uid git_dir git_uid
  user_uid=$(id -u "$UPGRADE_USER") || return 1
  repository_uid=$(stat -c %u -- "$CHINACHU_DIR") || return 1
  [ "$user_uid" = "$repository_uid" ] || {
    upgrade_error "The Upgrade user does not own the Chinachu repository: $UPGRADE_USER"
    return 1
  }

  git_dir=$(upgrade_git rev-parse --absolute-git-dir 2>/dev/null) || {
    upgrade_error "The Git metadata directory could not be resolved as $UPGRADE_USER."
    return 1
  }
  git_uid=$(stat -c %u -- "$git_dir") || return 1
  [ "$user_uid" = "$git_uid" ] || {
    upgrade_error "The Upgrade user does not own the Git metadata directory: $git_dir"
    return 1
  }
  upgrade_as_user test -w "$CHINACHU_DIR" && upgrade_as_user test -w "$git_dir" || {
    upgrade_error "$UPGRADE_USER cannot write the repository or its Git metadata."
    return 1
  }
}

upgrade_pm2_state_valid () {
  printf '%s' "$1" | "$BOOTSTRAP_NODE_COMMAND" -e '
    const fs = require("fs"), path = require("path");
    const root = path.resolve(process.argv[1]);
    const mode = process.argv[2];
    const list = JSON.parse(fs.readFileSync(0, "utf8").trim() || "[]");
    const expected = new Map([
      ["chinachu-operator", path.join(root, "app-operator.js")],
      ["chinachu-wui", path.join(root, "app-wui.js")]
    ]);
    const found = list.filter(item => item && expected.has(item.name));
    if (!found.length) process.exit(0);
    if (found.length !== 2 || new Set(found.map(item => item.name)).size !== 2) process.exit(1);
    for (const item of found) {
      const env = item.pm2_env || item;
      const cwd = env.pm_cwd || env.cwd || root;
      const script = env.pm_exec_path || env.script || item.pm_exec_path || item.script;
      if (!script || path.resolve(cwd, script) !== expected.get(item.name)) process.exit(1);
      if (env.exec_mode && !["fork", "fork_mode"].includes(env.exec_mode)) process.exit(1);
      if (mode === "active" || mode === "failed-start") {
        const status = env.status;
        const pid = Number(item.pid);
        if (status !== "online" && status !== "stopped" && !(mode === "failed-start" && status === "errored")) process.exit(1);
        if (status === "online" && !(pid > 0)) process.exit(1);
        if (status !== "online" && pid > 0) process.exit(1);
      }
    }
  ' "$CHINACHU_DIR" "$2"
}

upgrade_pm2_online_names () {
  printf '%s' "$1" | "$BOOTSTRAP_NODE_COMMAND" -e '
    const list = JSON.parse(require("fs").readFileSync(0, "utf8").trim() || "[]");
    const names = ["chinachu-operator", "chinachu-wui"].filter(name => {
      const item = list.find(entry => entry && entry.name === name);
      return item && item.pm2_env && item.pm2_env.status === "online" && Number(item.pid) > 0;
    });
    process.stdout.write(names.join(" "));
  '
}

upgrade_pm2_identity_valid () {
  local output="$1" names="$2" expected_uid="$3" expected_gid="$4" name pid uid gid
  for name in $names
  do
    pid=$(printf '%s' "$output" | "$BOOTSTRAP_NODE_COMMAND" -e '
      const list = JSON.parse(require("fs").readFileSync(0, "utf8").trim() || "[]");
      const item = list.find(entry => entry && entry.name === process.argv[1]);
      if (!item || !Number(item.pid)) process.exit(1);
      process.stdout.write(String(item.pid));
    ' "$name") || return 1
    [ -r "/proc/$pid/status" ] || return 1
    uid=$(awk '/^Uid:/ { print $2 }' "/proc/$pid/status") || return 1
    gid=$(awk '/^Gid:/ { print $2 }' "/proc/$pid/status") || return 1
    [ "$uid" = "$expected_uid" ] && [ "$gid" = "$expected_gid" ] || return 1
    printf '%s\n' "$SERVICE_SETUP_PROCESS_PIDS" | grep -Fxq -- "$pid" || return 1
  done
}

upgrade_pm2_runtime_valid () {
  local output="$1" names="$2" version="$3" name pid expected
  expected=$(readlink -f -- "$NAVE_DIR/installed/$version/bin/node") || return 1
  for name in $names; do
    pid=$(printf '%s' "$output" | "$BOOTSTRAP_NODE_COMMAND" -e '
      const list = JSON.parse(require("fs").readFileSync(0, "utf8"));
      const item = list.find(item => item.name === process.argv[1]);
      if (!item || !Number.isInteger(item.pid) || item.pid <= 0) process.exit(1);
      process.stdout.write(String(item.pid));
    ' "$name") || return 1
    [ "$(readlink -f -- "/proc/$pid/exe")" = "$expected" ] || return 1
  done
}

upgrade_pm2_status () {
  printf '%s' "$1" | "$BOOTSTRAP_NODE_COMMAND" -e '
    const fs = require("fs");
    const active = JSON.parse(fs.readFileSync(0, "utf8").trim() || "[]");
    const name = process.argv[1];
    const item = active.find(entry => entry && entry.name === name);
    if (item) {
      process.stdout.write(String((item.pm2_env || item).status));
    }
  ' "$2"
}

upgrade_pm2_daemon_state_safe () {
  local home
  service_setup_pm2_daemon_active "$1" && return 0
  home=$(service_setup_user_home "$1") || return 1
  [ ! -e "$home/.pm2/pm2.pid" ] && [ ! -e "$home/.pm2/rpc.sock" ] && [ ! -e "$home/.pm2/pub.sock" ]
}

upgrade_processes_match_state () {
  local state="$1" pid
  while read -r pid; do
    [ -z "$pid" ] && continue
    printf '%s' "$state" | service_setup_json_has_pid "$pid" || return 1
  done <<< "$SERVICE_SETUP_PROCESS_PIDS"
}

upgrade_inspect_pm2_manager () {
  local include_root="$1" local_has=false root_has=false

  SERVICE_SETUP_PM2_BIN=$(service_setup_find_pm2 2>/dev/null || true)
  SERVICE_SETUP_LOCAL_USER="$UPGRADE_USER"
  SERVICE_SETUP_INCLUDE_ROOT="$include_root"
  SERVICE_SETUP_ROOT_ACTIVE='[]'
  SERVICE_SETUP_ROOT_SAVED='[]'
  upgrade_pm2_daemon_state_safe "$SERVICE_SETUP_LOCAL_USER" || {
    upgrade_error "Local PM2 daemon artifacts exist, but an existing daemon connection could not be verified."
    return 1
  }
  if [ "$include_root" = true ]; then
    upgrade_pm2_daemon_state_safe root || {
      upgrade_error "Root PM2 daemon artifacts exist, but an existing daemon connection could not be verified."
      return 1
    }
  fi
  service_setup_capture_state "$include_root" || { upgrade_error "PM2 state could not be inspected."; return 1; }
  service_setup_all_pm2_state_known || {
    upgrade_error "The Local PM2 active or saved state could not be inspected safely."
    return 1
  }
  upgrade_pm2_state_valid "$SERVICE_SETUP_LOCAL_ACTIVE" active && \
    upgrade_pm2_state_valid "$SERVICE_SETUP_LOCAL_SAVED" saved || {
      upgrade_error "Local PM2 has an incomplete, abnormal, or foreign-path Chinachu registration."
      return 1
    }
  if service_setup_state_value_has_chinachu SERVICE_SETUP_LOCAL_ACTIVE || \
    service_setup_state_value_has_chinachu SERVICE_SETUP_LOCAL_SAVED; then local_has=true; fi

  if [ "$include_root" = true ]; then
    upgrade_pm2_state_valid "$SERVICE_SETUP_ROOT_ACTIVE" active && \
      upgrade_pm2_state_valid "$SERVICE_SETUP_ROOT_SAVED" saved || {
        upgrade_error "Root PM2 has an incomplete, abnormal, or foreign-path Chinachu registration."
        return 1
      }
    if service_setup_state_value_has_chinachu SERVICE_SETUP_ROOT_ACTIVE || \
      service_setup_state_value_has_chinachu SERVICE_SETUP_ROOT_SAVED; then root_has=true; fi
    if [ "$local_has" = true ] && [ "$root_has" = true ]; then
      upgrade_error "Chinachu is registered in both Local and Root PM2. Resolve the conflict before upgrading."
      return 1
    fi
  fi

  if ! service_setup_processes_are_attributed; then
    if [ "$include_root" = true ]; then
      upgrade_error "A Chinachu process cannot be attributed to the inspected PM2 registration."
      return 1
    fi
    return 2
  fi

  if [ "$local_has" = true ]; then
    manager_prefix=LOCAL
    manager_user="$SERVICE_SETUP_LOCAL_USER"
    manager_active="$SERVICE_SETUP_LOCAL_ACTIVE"
    manager_saved="$SERVICE_SETUP_LOCAL_SAVED"
    manager_expected_uid=$(id -u "$manager_user") || return 1
    manager_expected_gid=$(id -g "$manager_user") || return 1
  elif [ "$root_has" = true ]; then
    manager_prefix=ROOT
    manager_user=root
    manager_active="$SERVICE_SETUP_ROOT_ACTIVE"
    manager_saved="$SERVICE_SETUP_ROOT_SAVED"
    service_setup_resolve_config_identity || { upgrade_error "config.json runtime identity could not be resolved for Root PM2."; return 1; }
    [ "$SERVICE_SETUP_RUNTIME_USER" = "$UPGRADE_USER" ] || {
      upgrade_error "Root PM2 runtime user ($SERVICE_SETUP_RUNTIME_USER) does not match the repository owner ($UPGRADE_USER)."
      return 1
    }
    manager_expected_uid="$SERVICE_SETUP_EXPECTED_UID"
    manager_expected_gid="$SERVICE_SETUP_EXPECTED_GID"
  elif [ "$include_root" != true ]; then
    return 2
  fi

  if [ -n "$manager_prefix" ] && [ -z "$SERVICE_SETUP_PM2_BIN" ]; then
    upgrade_error "PM2 registration exists but the pm2 command is unavailable."
    return 1
  fi
  online_names=$(upgrade_pm2_online_names "$manager_active") || return 1
  if [ -n "$online_names" ]; then
    upgrade_pm2_identity_valid "$manager_active" "$online_names" "$manager_expected_uid" "$manager_expected_gid" || {
      upgrade_error "A running Chinachu PM2 process does not match its registration, path, or runtime identity."
      return 1
    }
  fi
}

upgrade_revalidate_pm2_manager () {
  local current_active current_online current_pids
  [ -n "$manager_prefix" ] || return 0

  if ! service_setup_pm2_daemon_active "$manager_user"; then
    current_pids=$(service_setup_chinachu_pids 2>/dev/null) || current_pids=''
    [ -z "$online_names" ] && [ -z "$current_pids" ] || {
      upgrade_error "The selected PM2 manager changed before service control."
      return 1
    }
    return 0
  fi
  current_active=$(service_setup_pm2_as_user "$manager_user" jlist 2>/dev/null) && \
    printf '%s' "$current_active" | service_setup_json_is_array || {
      upgrade_error "The selected PM2 manager could not be rechecked before service control."
      return 1
    }
  upgrade_pm2_state_valid "$current_active" active || {
    upgrade_error "The selected PM2 registration changed before service control."
    return 1
  }
  current_online=$(upgrade_pm2_online_names "$current_active") || return 1
  [ "$current_online" = "$online_names" ] || {
    upgrade_error "The set of running Chinachu services changed before service control."
    return 1
  }
  SERVICE_SETUP_PROCESS_PIDS=$(service_setup_chinachu_pids 2>/dev/null) || SERVICE_SETUP_PROCESS_PIDS=''
  upgrade_processes_match_state "$current_active" || {
    upgrade_error "A Chinachu process is no longer attributed to the selected PM2 manager."
    return 1
  }
  upgrade_pm2_identity_valid "$current_active" "$current_online" "$manager_expected_uid" "$manager_expected_gid" || {
    upgrade_error "A running Chinachu process changed before service control."
    return 1
  }
  manager_active="$current_active"
}

upgrade_file_requires_restart () {
  case "$1" in
    README.md | CHANGELOG.md | LICENSE | NOTICE | test/* | docs/* | *.md ) return 1 ;;
    * ) return 0 ;;
  esac
}

upgrade_activity_snapshot () {
  "$BOOTSTRAP_NODE_COMMAND" -e '
    const fs = require("fs");
    let recording, reserves;
    try {
      recording = JSON.parse(fs.readFileSync("data/recording.json", "utf8"));
      reserves = JSON.parse(fs.readFileSync("data/reserves.json", "utf8"));
      if (!Array.isArray(recording) || !Array.isArray(reserves)) throw new Error("expected JSON arrays");
    } catch (error) {
      console.error("Could not inspect recording/reservation status: " + error.message);
      process.exit(1);
    }

    const now = Date.now();
    let next = Infinity;
    for (const reserve of reserves) {
      if (!reserve) continue;
      const start = Number(reserve.start);
      if (Number.isFinite(start) && start > now && start < next) next = start;
    }

    let nextLabel = "なし";
    if (next !== Infinity) {
      const date = new Date(next);
      const minutes = Math.ceil((next - now) / 60000);
      const timeLeft = minutes < 60
        ? `${minutes}分後`
        : minutes < 1440
          ? `${Math.floor(minutes / 60)}時間${minutes % 60 ? `${minutes % 60}分` : ""}後`
          : `${Math.floor(minutes / 1440)}日${Math.floor((minutes % 1440) / 60) ? `${Math.floor((minutes % 1440) / 60)}時間` : ""}後`;
      const pad = n => String(n).padStart(2, "0");
      nextLabel = `約${timeLeft} (${pad(date.getMonth() + 1)}/${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())})`;
    }
    process.stdout.write(`${recording.length}\t${nextLabel}\n`);
  '
}

upgrade_show_activity () {
  local count="$1" next="$2"
  printf '\n録画中 : '
  if [ "$count" -eq 0 ]; then
    printf 'なし\n'
  else
    printf '%s件\n' "$count"
  fi
  printf '次の録画予約 : %s\n' "$next"
  printf 'Running Chinachu services will stop during the update; nearby reservations may be affected.\n'
}

upgrade_runtime_repair_needed () {
  [ -n "$manager_prefix" ] || return 1
  if ! chinachu_installer_node_ready || ! chinachu_installer_dependencies_ready ||
     compgen -G "$NAVE_DIR/installed/24.*" > /dev/null; then
    return 0
  fi
  # The PM2 inspection is read-only; runtime repair is only announced when needed.
  "$NODE_PATH" "$CHINACHU_DIR/lib/pm2-runtime-migrate.js" \
    "$CHINACHU_DIR" "$SERVICE_SETUP_PM2_BIN" "$manager_user" check > /dev/null 2>&1 && return 1
  return 0
}

upgrade_show_runtime_notice () {
  if compgen -G "$NAVE_DIR/installed/24.*" > /dev/null; then
    printf '\nNode.js 24から26への移行を行います。\n'
  else
    printf '\nNode.js 26の実行環境を更新します。\n'
  fi
  if [ -n "$manager_prefix" ]; then
    printf '必要に応じてPM2を入れ直し、Chinachuと同じPM2で管理するサービスを一時停止・再起動します。\n'
    printf '更新中は対象サービスを一時的に利用できません。\n'
  else
    printf '更新中はChinachuを一時的に利用できない場合があります。\n'
  fi
}

upgrade_confirm () {
  local recording_count="${1:-0}" runtime_notice="${2:-false}" answer
  [ -t 0 ] || { upgrade_error "Upgrade application requires an interactive terminal."; return 1; }
  if [ "$runtime_notice" = true ]; then upgrade_show_runtime_notice; fi
  if [ "$recording_count" -gt 0 ]; then
    printf '\n%sWARNING:%s %s active recording(s) may be interrupted and left incomplete.\n' \
      "$INSTALLER_YELLOW" "$INSTALLER_RESET" "$recording_count"
    read -r -p 'Continue upgrade even though recording is active? [y/N] ' answer || return 1
  elif [ "$runtime_notice" = true ]; then
    read -r -p '更新を続行しますか？ [y/N] ' answer || return 1
  else
    read -r -p 'Apply this fast-forward update? [y/N] ' answer || return 1
  fi
  case "$answer" in y | Y | yes | YES ) return 0 ;; esac
  printf 'Upgrade was not applied.\n'
  return 1
}

upgrade_start_existing_runtime () {
  local home uid
  home=$(service_setup_user_home "$manager_user") || return 1
  uid=$(id -u "$manager_user") || return 1
  printf '%s' "$manager_active" | "$BOOTSTRAP_NODE_COMMAND" "$CHINACHU_DIR/lib/pm2-runtime-client.js" start "$SERVICE_SETUP_PM2_BIN" "$home/.pm2" "$uid" "$CHINACHU_DIR" "$online_names"
}

upgrade_failed () {
  upgrade_error "Upgrade failed at: $1. No automatic source/runtime rollback was attempted."
  printf 'Manager: %s; previously online: %s. Recheck recording/reservation and current PM2 state before service control.\n' "${manager_user:-unregistered}" "${online_names:-none}" >&2
  printf 'After repairing the target environment, run installer bootstrap and installer verify as the repository owner, then start only the previously online services with --interpreter %s/.nave/node.\n' "$CHINACHU_DIR" >&2
  return 1
}

upgrade_cleanup_failed_start () {
  local active running name activity count next
  service_setup_pm2_daemon_active "$manager_user" || return 1
  active=$(service_setup_pm2_as_user "$manager_user" jlist) || return 1
  upgrade_pm2_state_valid "$active" failed-start || return 1
  running=$(upgrade_pm2_online_names "$active") || return 1
  [ -n "$running" ] || return 0
  for name in $running; do
    case " $online_names " in *" $name "*) ;; *) return 1 ;; esac
  done
  SERVICE_SETUP_PROCESS_PIDS=$(service_setup_chinachu_pids) || return 1
  upgrade_pm2_identity_valid "$active" "$running" "$manager_expected_uid" "$manager_expected_gid" || return 1
  activity=$(upgrade_activity_snapshot) || return 1
  IFS=$'\t' read -r count next <<< "$activity"
  [ "$count" = 0 ] || return 1
  service_setup_pm2_as_user "$manager_user" stop $running || return 1
  active=$(service_setup_pm2_as_user "$manager_user" jlist) || return 1
  upgrade_pm2_state_valid "$active" failed-start || return 1
  running=$(upgrade_pm2_online_names "$active") || return 1
  [ -z "$running" ]
}

upgrade_start_failed () {
  if ! upgrade_cleanup_failed_start; then
    upgrade_error "Partial start could not be cleaned up safely (recording, unknown state or identity). Some services may still be running; do not switch runtime links."
  fi
  upgrade_failed "$1"
}

upgrade_pm2_persistence_report () {
  [ -n "$manager_prefix" ] || return 0
  "$BOOTSTRAP_NODE_COMMAND" -e '
    const path = require("path");
    const [root, version, activeJson, savedJson, manager] = process.argv.slice(1);
    const active = JSON.parse(activeJson), saved = JSON.parse(savedJson);
    const names = ["chinachu-operator", "chinachu-wui"];
    const link = path.join(root, ".nave/node");
    const binary = path.join(root, ".nave/installed", version, "bin/node");
    let pending = false;
    for (const [label, list] of [["active", active], ["saved", saved]]) {
      for (const name of names) {
        const item = list.find(item => item && item.name === name);
        const env = item && (item.pm2_env || item);
        const interpreter = env && env.exec_interpreter;
        const resolved = interpreter && interpreter !== "node" ? path.resolve(env.pm_cwd || env.cwd || root, interpreter) : null;
        if (resolved === link || resolved === binary) continue;
        pending = true;
        console.warn(`PM2 ${manager} ${label}: ${name} is ${!item ? "not registered" : "not pinned to the target runtime"}.`);
        console.warn(`Review this manager before OS restart. Set only Chinachu exec_interpreter to ${link}; preserve other processes and saved-only entries.`);
      }
    }
    console.log("PM2 saved state was not written. Run ./chinachu runtime-check (explicit sudo for Root PM2) before reboot. Check startup, dump.pm2 and dump.pm2.bak; use pm2 save only after reviewing all active/saved differences.");
    if (pending) process.exitCode = 2;
  ' "$CHINACHU_DIR" "$upstream_node_version" "$manager_active" "$manager_saved" "$manager_user"
}

chinachu_upgrade () {
  local status branch upstream remote changed_files upstream_launcher upstream_node_version
  local dependencies_needed=false node_needed=false restart_needed=false
  local runtime_approved=false runtime_notice=false
  local manager_prefix='' manager_user='' manager_active='[]' manager_saved='[]'
  local manager_expected_uid='' manager_expected_gid='' online_names='' operator_status='' wui_status='' file
  local source_build="${1:-}"
  case "$source_build" in "" | --allow-source-build) ;; *) upgrade_error "Unknown Upgrade option: $source_build"; return 1 ;; esac
  local inspect_status activity recording_count=0 next_reservation='' latest_activity latest_recording_count latest_next_reservation

  . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
  if [ "$(id -u)" -eq 0 ]; then
    command -v runuser > /dev/null 2>&1 || { upgrade_error "runuser is required."; return 1; }
    UPGRADE_USER=$(service_setup_origin_user) || { upgrade_error "A valid non-root SUDO_USER is required."; return 1; }
  else
    UPGRADE_USER=$(id -un) || return 1
  fi
  upgrade_verify_repository_owner || return 1
  resolve_bootstrap_node || return 1

  if [ "$(id -u)" -eq 0 ]; then
    upgrade_inspect_pm2_manager true || return 1
  else
    upgrade_inspect_pm2_manager false
    inspect_status=$?
    if [ "$inspect_status" -eq 2 ]; then
      printf '\nLocal PM2ではChinachuの管理先を確認できませんでした。\n\n'
      printf 'root PM2で管理されている可能性があるため、\n'
      printf '管理者権限でPM2登録状態を確認します。\n\n'
      printf 'sudoのパスワード入力を求められる場合があります。\n\n'
      if [ ! -t 0 ]; then
        upgrade_error "非対話環境ではsudo認証を開始しません。TTYから ./chinachu upgrade を実行してください。"
        return 1
      fi
      command -v sudo > /dev/null 2>&1 || {
        upgrade_error "sudoが見つかりません。管理者権限を利用できる環境で ./chinachu upgrade を実行してください。"
        return 1
      }
      sudo -- "$CHINACHU_DIR/chinachu" upgrade "$@"
      return $?
    elif [ "$inspect_status" -ne 0 ]; then
      return "$inspect_status"
    fi

    operator_status=$(upgrade_pm2_status "$manager_active" chinachu-operator) || return 1
    wui_status=$(upgrade_pm2_status "$manager_active" chinachu-wui) || return 1
    [ -n "$operator_status" ] || operator_status='stopped (saved)'
    [ -n "$wui_status" ] || wui_status='stopped (saved)'
    printf '\nChinachu Upgrade\n--------------------------------\n\n'
    printf 'PM2管理方式 : Local PM2\n'
    printf '管理ユーザー : %s\n' "$manager_user"
    printf 'Operator     : %s\n' "$operator_status"
    printf 'WUI          : %s\n\n' "$wui_status"
    printf '現在のユーザーで更新を実行します。\n'
    printf '実行環境の更新が必要な場合は管理者権限を使用します。\n'
  fi

  printf '\nChinachu Upgrade preflight\n────────────────────────────────\n'

  inspect_repository_ffmpeg
  if [ "$FFMPEG_LOCAL_STATE" != none ] || ! verify_runtime_ffmpeg; then
    upgrade_error "FFmpeg/ffprobe is not in the supported runtime state. Run ./chinachu installer ffmpeg first."
    return 1
  fi
  print_ffmpeg_commands "Runtime"

  # Runtime repair is independent of whether Git can update this working tree.
  if [ -n "$manager_prefix" ]; then
    if upgrade_runtime_repair_needed; then
      upgrade_confirm 0 true || return $?
      runtime_approved=true
    fi
    service_setup_runtime_repair "${manager_prefix,,}" "$source_build" || { upgrade_failed "runtime repair"; return 1; }
    upgrade_inspect_pm2_manager "$SERVICE_SETUP_INCLUDE_ROOT" || return 1
  else
    # An unmanaged installation still needs the target runtime; never register PM2 here.
    upgrade_as_user "$CHINACHU_DIR/chinachu" installer node-prepare "$NODE_VER" "$source_build" || { upgrade_failed "Node.js preparation"; return 1; }
    if ! chinachu_installer_node_ready; then
      upgrade_as_user "$CHINACHU_DIR/chinachu" installer node "$source_build" || { upgrade_failed "Node.js activation"; return 1; }
    fi
    if ! chinachu_installer_dependencies_ready; then
      upgrade_as_user "$CHINACHU_DIR/chinachu" installer dependencies || { upgrade_failed "dependency installation/publication"; return 1; }
    fi
    upgrade_as_user "$CHINACHU_DIR/chinachu" installer verify || { upgrade_failed "runtime verification"; return 1; }
    upgrade_as_user "$NODE_PATH" "$CHINACHU_DIR/lib/pm2-runtime-migrate.js" "$CHINACHU_DIR" '' '' prune || { upgrade_failed "Node 24 removal"; return 1; }
  fi
  status=$(upgrade_git status --porcelain --untracked-files=all) || return 1
  if [ -n "$status" ]; then
    printf 'Runtime verified/repaired. Source update skipped: the working tree has tracked or untracked changes.\n'
    return 0
  fi
  branch=$(upgrade_git branch --show-current) || return 1
  [ -n "$branch" ] || { upgrade_error "Detached HEAD is not supported by Upgrade."; return 1; }
  upstream=$(upgrade_git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || {
    upgrade_error "The current branch has no upstream tracking branch."
    return 1
  }
  remote=$(upgrade_git config --get "branch.${branch}.remote") || return 1
  [ -n "$remote" ] && [ "$remote" != . ] || { upgrade_error "A remote tracking branch is required."; return 1; }
  printf 'Git: %s -> %s (%s)\n' "$branch" "$upstream" "$remote"
  upgrade_git fetch -- "$remote" || { upgrade_error "git fetch failed; no update was applied."; return 1; }
  status=$(upgrade_git status --porcelain --untracked-files=all) || return 1
  [ -z "$status" ] || { upgrade_error "The working tree changed during preflight."; return 1; }
  upgrade_git merge-base --is-ancestor HEAD "$upstream" || {
    upgrade_error "The tracking branch cannot be applied as a fast-forward."
    return 1
  }

  changed_files=$(upgrade_git diff --name-only HEAD "$upstream") || return 1
  if [ -z "$changed_files" ]; then
    printf 'Already up to date; runtime repair/verification completed.\n'
    return 0
  fi

  upstream_launcher=$(upgrade_git show "$upstream:chinachu") || return 1
  upstream_node_version=$(printf '%s\n' "$upstream_launcher" | sed -n 's/^NODE_VER=//p' | sed -n '1p')
  [[ "$upstream_node_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { upgrade_error "Could not determine the target Node.js version."; return 1; }
  if [ "$upstream_node_version" != "$NODE_VER" ] || ! chinachu_installer_node_ready; then node_needed=true; fi
  if printf '%s\n' "$changed_files" | grep -Eq '^(package.json|package-lock.json|common/package.json)$' || ! chinachu_installer_dependencies_ready; then
    dependencies_needed=true
  fi
  # A runtime change must rebuild native dependencies even with an unchanged lockfile.
  if [ "$node_needed" = true ]; then dependencies_needed=true; fi
  while IFS= read -r file; do
    if upgrade_file_requires_restart "$file"; then restart_needed=true; break; fi
  done <<< "$changed_files"
  if [ "$node_needed" = true ] || [ "$dependencies_needed" = true ]; then restart_needed=true; fi

  upgrade_as_user test -w "$CHINACHU_DIR" || { upgrade_error "$UPGRADE_USER cannot update the working tree."; return 1; }
  if [ "$node_needed" = true ] && [ -e "$NAVE_DIR" ]; then
    [ "$(stat -c %u -- "$NAVE_DIR")" = "$(id -u "$UPGRADE_USER")" ] || { upgrade_error "$UPGRADE_USER does not own $NAVE_DIR."; return 1; }
    upgrade_as_user test -w "$NAVE_DIR" || { upgrade_error "$UPGRADE_USER cannot repair $NAVE_DIR."; return 1; }
    if [ -e "$NAVE_DIR/installed/$upstream_node_version" ]; then
      [ "$(stat -c %u -- "$NAVE_DIR/installed/$upstream_node_version")" = "$(id -u "$UPGRADE_USER")" ] || { upgrade_error "$UPGRADE_USER does not own the target Nave runtime."; return 1; }
      upgrade_as_user test -w "$NAVE_DIR/installed/$upstream_node_version" || { upgrade_error "$UPGRADE_USER cannot repair the target Nave runtime."; return 1; }
    fi
  fi
  if [ "$dependencies_needed" = true ] && [ -e "$CHINACHU_DIR/node_modules" ]; then
    [ "$(stat -c %u -- "$CHINACHU_DIR/node_modules")" = "$(id -u "$UPGRADE_USER")" ] || { upgrade_error "$UPGRADE_USER does not own node_modules."; return 1; }
    upgrade_as_user test -w "$CHINACHU_DIR/node_modules" || { upgrade_error "$UPGRADE_USER cannot replace node_modules."; return 1; }
  fi

  printf 'Changed files: %s\n' "$(printf '%s\n' "$changed_files" | wc -l)"
  printf 'Node.js repair: %s\nDependencies repair: %s\nService restart: %s\n' "$node_needed" "$dependencies_needed" "$restart_needed"
  if [ -n "$manager_prefix" ]; then
    printf 'PM2 manager: %s (%s), currently online: %s\n' "$manager_prefix" "$manager_user" "${online_names:-none}"
  else
    printf 'PM2 manager: unregistered (Upgrade will not register services)\n'
  fi

  if [ "$restart_needed" = true ] && [ -n "$online_names" ]; then
    activity=$(upgrade_activity_snapshot) || {
      upgrade_error "Could not verify recording/reservation status before upgrade."
      return 1
    }
    IFS=$'\t' read -r recording_count next_reservation <<< "$activity"
    upgrade_show_activity "$recording_count" "$next_reservation"
  fi

  # Runtime migration was already approved before PM2/Node changes began.
  if [ "$runtime_approved" != true ] || [ "$recording_count" -gt 0 ]; then
    if [ "$runtime_approved" != true ] && [ "$node_needed" = true ] &&
       compgen -G "$NAVE_DIR/installed/24.*" > /dev/null; then
      runtime_notice=true
    fi
    upgrade_confirm "$recording_count" "$runtime_notice" || return $?
  fi

  if [ "$node_needed" = true ]; then
    upgrade_as_user "$CHINACHU_DIR/chinachu" installer node-prepare "$upstream_node_version" "$source_build" || {
      upgrade_error "Node.js preparation failed; services and runtime links were not changed."
      return 1
    }
  fi

  if [ "$restart_needed" = true ]; then
    upgrade_revalidate_pm2_manager || return 1
  fi
  if [ "$restart_needed" = true ] && [ -n "$online_names" ]; then
    latest_activity=$(upgrade_activity_snapshot) || {
      upgrade_error "Could not recheck recording/reservation status before stopping services."
      return 1
    }
    IFS=$'\t' read -r latest_recording_count latest_next_reservation <<< "$latest_activity"
    if [ "$recording_count" -eq 0 ] && [ "$latest_recording_count" -gt 0 ]; then
      printf '\nA recording started while awaiting confirmation.\n'
      upgrade_show_activity "$latest_recording_count" "$latest_next_reservation"
      upgrade_confirm "$latest_recording_count" || return $?
    fi
  fi
  if [ "$restart_needed" = true ] && [ -n "$online_names" ]; then
    service_setup_pm2_as_user "$manager_user" stop $online_names || {
      upgrade_failed "PM2 stop (some services may already be stopped)"
      return 1
    }
  fi

  if ! upgrade_git merge --ff-only "$upstream"; then
    upgrade_failed "fast-forward application"
    return 1
  fi

  if [ "$node_needed" = true ]; then
    upgrade_as_user "$CHINACHU_DIR/chinachu" installer node || {
      upgrade_failed "Node.js activation"
      return 1
    }
  fi
  if [ "$dependencies_needed" = true ]; then
    upgrade_as_user "$CHINACHU_DIR/chinachu" installer dependencies || {
      upgrade_failed "dependency installation/publication"
      return 1
    }
  fi
  upgrade_as_user "$CHINACHU_DIR/chinachu" installer bootstrap || { upgrade_failed "runtime bootstrap"; return 1; }
  upgrade_as_user "$CHINACHU_DIR/chinachu" installer verify || {
    upgrade_failed "post-update verification"
    return 1
  }

  if [ "$restart_needed" = true ] && [ -n "$online_names" ]; then
    service_setup_pm2_daemon_active "$manager_user" || {
      upgrade_failed "PM2 daemon unavailable before start"
      return 1
    }
    upgrade_start_existing_runtime || {
      upgrade_start_failed "PM2 start"
      return 1
    }
    manager_active=$(service_setup_pm2_as_user "$manager_user" jlist) || { upgrade_start_failed "PM2 state read after start"; return 1; }
    [ "$(upgrade_pm2_online_names "$manager_active")" = "$online_names" ] || {
      upgrade_start_failed "PM2 partial start"
      return 1
    }
    upgrade_pm2_runtime_valid "$manager_active" "$online_names" "$upstream_node_version" || {
      upgrade_start_failed "PM2 runtime verification"
      return 1
    }
    SERVICE_SETUP_PROCESS_PIDS=$(service_setup_chinachu_pids) || { upgrade_start_failed "process attribution"; return 1; }
    upgrade_pm2_identity_valid "$manager_active" "$online_names" "$manager_expected_uid" "$manager_expected_gid" || {
      upgrade_start_failed "PM2 identity verification"
      return 1
    }
  fi

  if [ -n "$manager_prefix" ]; then
    service_setup_runtime_repair "${manager_prefix,,}" "$source_build" || { upgrade_failed "PM2 daemon/startup unification"; return 1; }
    manager_saved=$(cat -- "$(service_setup_user_home "$manager_user")/.pm2/dump.pm2") || return 1
  fi
  upgrade_pm2_persistence_report
  status=$?
  case "$status" in
    0) ;;
    *) upgrade_failed "PM2 persistence verification"; return 1 ;;
  esac
  printf '\nUpgrade completed. PM2 manager/service selection and saved state were preserved.\n'
  chinachu_auth_setup_hint "$UPGRADE_USER"
}

chinachu_runtime_check () {
  . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
  resolve_bootstrap_node || return 1
  if [ "$(id -u)" -eq 0 ]; then
    SERVICE_SETUP_LOCAL_USER=$(service_setup_origin_user) || return 1
    SERVICE_SETUP_INCLUDE_ROOT=true
  else
    SERVICE_SETUP_LOCAL_USER=$(id -un) || return 1
    SERVICE_SETUP_INCLUDE_ROOT=false
    printf 'Root PM2 is not inspected without an explicit sudo invocation.\n' >&2
  fi
  SERVICE_SETUP_PM2_BIN=$(service_setup_find_pm2 2>/dev/null || true)
  service_setup_capture_state "$SERVICE_SETUP_INCLUDE_ROOT" || return 1
  local user="$SERVICE_SETUP_LOCAL_USER" home root_home
  home=$(service_setup_user_home "$user") || return 1
  root_home=$(service_setup_user_home root) || return 1
  {
    printf '{"managers":[{"user":"%s","home":"%s","active":%s,"saved":%s,"activeKnown":%s,"savedKnown":%s}' "$user" "$home" "$SERVICE_SETUP_LOCAL_ACTIVE" "$SERVICE_SETUP_LOCAL_SAVED" "$SERVICE_SETUP_LOCAL_ACTIVE_KNOWN" "$SERVICE_SETUP_LOCAL_SAVED_KNOWN"
    if [ "$SERVICE_SETUP_INCLUDE_ROOT" = true ]; then
      printf ',{"user":"root","home":"%s","active":%s,"saved":%s,"activeKnown":%s,"savedKnown":%s}' "$root_home" "$SERVICE_SETUP_ROOT_ACTIVE" "$SERVICE_SETUP_ROOT_SAVED" "$SERVICE_SETUP_ROOT_ACTIVE_KNOWN" "$SERVICE_SETUP_ROOT_SAVED_KNOWN"
    fi
    printf ']}'
  } | "$BOOTSTRAP_NODE_COMMAND" "$CHINACHU_DIR/tools/runtime-diagnostics.js" "$CHINACHU_DIR" "$NODE_VER"
}

chinachu_service () {
  if [ "$1" = runtime-repair ]; then
    . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
    shift
    service_setup_runtime_repair "$@"
    return $?
  fi
  if [ "$1" = "setup" ]; then
    . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
    shift
    chinachu_service_setup "$@"
    return $?
  fi

  chinachu_service_help
}

