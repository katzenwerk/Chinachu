#!/bin/bash

# Chinachu-CLI
# ------------
#
#   Usage:
#
#     ./chinachu <cmd> ...
#

if [ -z "$BASH" ]; then
  echo "Chinachu-CLI only works with bash.  Sorry." >&2
  exit 1
fi

shopt -s extglob

# variables
NODE_VER=24.20.0

declare -A BOOTSTRAP_EXISTING_CHECKSUMS=()
BOOTSTRAP_NODE_COMMAND=""
BOOTSTRAP_RUNTIME_USER=""
BOOTSTRAP_RECORDED_DIR=""

if [ -t 1 ]; then
  INSTALLER_GREEN=$'\033[32m'
  INSTALLER_RED=$'\033[31m'
  INSTALLER_YELLOW=$'\033[33m'
  INSTALLER_RESET=$'\033[0m'
else
  INSTALLER_GREEN=""
  INSTALLER_RED=""
  INSTALLER_YELLOW=""
  INSTALLER_RESET=""
fi

main () {
  local SELF_PATH DIR SYM
  # get the absolute path of the executable
  SELF_PATH="$0"
  if [ "${SELF_PATH:0:1}" != "." ] && [ "${SELF_PATH:0:1}" != "/" ]; then
    SELF_PATH=./"$SELF_PATH"
  fi
  SELF_PATH=$( cd -P -- "$(dirname -- "$SELF_PATH")" \
            && pwd -P \
            ) && SELF_PATH=$SELF_PATH/$(basename -- "$0")

  # resolve symlinks
  while [ -h "$SELF_PATH" ]; do
    DIR=$(dirname -- "$SELF_PATH")
    SYM=$(readlink -- "$SELF_PATH")
    SELF_PATH=$( cd -- "$DIR" \
              && cd -- $(dirname -- "$SYM") \
              && pwd \
              )/$(basename -- "$SYM")
  done

  # path
  CHINACHU_DIR=$(dirname -- "$SELF_PATH")
  NAVE_DIR=${CHINACHU_DIR}/.nave
  NODE_PATH=${NAVE_DIR}/installed/${NODE_VER}/bin/node
  NPM_PATH=${NAVE_DIR}/installed/${NODE_VER}/bin/npm
  USR_DIR=${CHINACHU_DIR}/usr

  export PATH=$USR_DIR/bin:${NAVE_DIR}/installed/${NODE_VER}/bin:$PATH
  export LD_LIBRARY_PATH=$USR_DIR/lib:$LD_LIBRARY_PATH
  export PKG_CONFIG_PATH=$USR_DIR/lib/pkgconfig

  cd $CHINACHU_DIR

  export CHINACHU_DIR
  export NAVE_DIR

  local cmd="$1"
  shift
  case $cmd in
    installer | updater | service | update | search | \
    reserve | unreserve | skip | unskip | stop | \
    rule | enrule | disrule | rmrule | \
    rules | reserves | recording | recorded | \
    cleanup | ircbot | test )
      cmd="chinachu_$cmd"
      ;;
    * )
      cmd="chinachu_help"
      ;;
  esac
  "$cmd" "$@"
  exit $?
}

chinachu_installer () {
  ensure_dir "$USR_DIR"
  ensure_dir "$USR_DIR/src"
  ensure_dir "$USR_DIR/bin"

  export CFLAGS="-O2 -w -pipe -march=native"
  export CXXFLAGS="-O2 -w -pipe -march=native"
  export MAKEFLAGS="-j $((`grep processor /proc/cpuinfo | wc -l` + 1)) -l 3"

  local choice="$1"

  if [ -z "$choice" ]; then
    printf '\nChinachu Installer\n────────────────────────────────\n\n'
    printf '1) Auto (Full)\n'
    printf '2) Submodules\n'
    printf '3) Node.js\n'
    printf '4) Dependencies\n'
    printf '5) FFmpeg\n'
    printf '6) Runtime Bootstrap\n'
    printf '7) Verify\n'
    printf '8) ChinachuのPM2サービス設定・確認\n'
    printf '0) Exit\n'
    [ -t 0 ] || { installer_error "非対話実行ではinstaller項目を引数で指定してください。"; return 1; }
    read -r -p '> ' choice
  fi

  case "$choice" in
    1 | auto | full ) chinachu_installer_auto_full ;;
    2 | submodule | submodules ) chinachu_installer_submodule ;;
    3 | node ) chinachu_installer_node ;;
    4 | dependencies | modules ) chinachu_installer_node_modules ;;
    5 | ffmpeg ) chinachu_installer_ffmpeg ;;
    6 | bootstrap | runtime ) chinachu_runtime_bootstrap ;;
    7 | verify ) chinachu_installer_verify ;;
    8 | service | pm2 ) chinachu_installer_pm2_service ;;
    0 | exit | quit ) return 0 ;;
    * )
      installer_error "installer項目を選択できませんでした: $choice"
      return 1
      ;;
  esac
}

chinachu_installer_auto_full () {
  installer_step 1 6 "Submodules"
  chinachu_installer_submodule || installer_error "Submodule installation failed."
  installer_success "Ready"

  installer_step 2 6 "Node.js"
  chinachu_installer_node || installer_error "Node.js installation failed."
  installer_success "v${NODE_VER}"

  installer_step 3 6 "Dependencies"
  chinachu_installer_node_modules || installer_error "Dependency installation failed."
  installer_success "Ready"

  installer_step 4 6 "FFmpeg"
  chinachu_installer_ffmpeg || installer_error "FFmpeg installation failed."
  installer_success "Ready"

  installer_step 5 6 "Runtime Bootstrap"
  chinachu_runtime_bootstrap || installer_error "Runtime bootstrap failed."
  installer_success "Ready"

  installer_step 6 6 "Verify"
  chinachu_installer_verify || installer_error "Installer verification failed."
  installer_success "Passed"

  chinachu_installer_offer_pm2 auto || return 1

  printf '\n%sInstallation completed successfully.%s\n' "$INSTALLER_GREEN" "$INSTALLER_RESET"

  return 0
}

chinachu_installer_offer_pm2 () {
  . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
  service_setup_installer_offer "$1"
}

chinachu_installer_pm2_service () {
  chinachu_installer_offer_pm2 menu
}

chinachu_installer_submodule () {
  git submodule init || return 1
  git submodule update || return 1

  return 0
}

chinachu_installer_node () {
  remove_dir "$NAVE_DIR" || return 1
  ensure_dir "$NAVE_DIR" || return 1

  echo "Installing Node using Nave..."
  wget -O "$NAVE_DIR/nave.sh" https://raw.githubusercontent.com/isaacs/nave/v3.2.2/nave.sh || return 1
  chmod a+x "$NAVE_DIR/nave.sh" || return 1
  "$NAVE_DIR/nave.sh" install "$NODE_VER" || return 1
  rm -fv "$NAVE_DIR/node" || return 1
  ln -sv "$NODE_PATH" "$NAVE_DIR/node" || return 1
  ln -sv "$NPM_PATH" "$NAVE_DIR/npm" || return 1

  [ -x "$NODE_PATH" ] || return 1
  [ "$("$NODE_PATH" --version)" = "v${NODE_VER}" ] || return 1

  echo "done."

  return 0
}

chinachu_installer_node_modules () {
  [ -x "$NPM_PATH" ] || fail "Nave npm is not available: $NPM_PATH"
  remove_dir node_modules || return 1

  echo "Installing Node Modules using NPM..."

  "$NPM_PATH" ci || return 1

  echo "done."

  return 0
}

chinachu_installer_ffmpeg () {
  remove_dir "$USR_DIR/src/ffmpeg" || return 1
  ensure_dir "$USR_DIR/src/ffmpeg" || return 1

  cd "$USR_DIR" || return 1

  MACHINE=`uname -m`
  if [ ${MACHINE} == "aarch64" ] || [ ${MACHINE} == "arm64" ] || [ ${MACHINE} == "armv8l" ]; then
    local FFMPEG_FN="ffmpeg-4.1.4-arm64-static"
  elif [ ${MACHINE} == "armhf" ] || [ ${MACHINE} == "armv7l" ]; then
    local FFMPEG_FN="ffmpeg-4.1.4-armhf-static"
  elif [ `echo ${MACHINE} | grep 'arm'` ]; then
    local FFMPEG_FN="ffmpeg-4.1.4-armel-static"
  elif [ ${MACHINE} == "x86_64" ]; then
    local FFMPEG_FN="ffmpeg-4.1.4-amd64-static"
  else
    local FFMPEG_FN="ffmpeg-4.1.4-i686-static"
  fi

  local FFMPEG_XZ="https://johnvansickle.com/ffmpeg/old-releases/${FFMPEG_FN}.tar.xz"

  wget -O "${FFMPEG_FN}.tar.xz" "$FFMPEG_XZ" || return 1
  xz -dv "${FFMPEG_FN}.tar.xz" || return 1

  tar -xvf "${FFMPEG_FN}.tar" -C bin --strip-components 1 || return 1
  rm -v "${FFMPEG_FN}.tar" || return 1

  cd "$CHINACHU_DIR" || return 1

  echo "Creating libav aliases..."

  rm -rfv "$USR_DIR/bin/avconv" || return 1
  rm -rfv "$USR_DIR/bin/avprobe" || return 1
  ln -sv "$USR_DIR/bin/ffmpeg" "$USR_DIR/bin/avconv" || return 1
  ln -sv "$USR_DIR/bin/ffprobe" "$USR_DIR/bin/avprobe" || return 1

  echo "ffmpeg --> done."

  return 0
}

chinachu_updater () {
  if [ -e "/etc/init.d/chinachu-operator" ]; then
    /etc/init.d/chinachu-operator status
  fi

  if [ -e "/etc/init.d/chinachu-wui" ]; then
    /etc/init.d/chinachu-wui status
  fi

  git fetch
  git status

  while [ 1 ]; do
    echo -n "Do you want to update [Y/n]? "
    read line
    case ${line:-y} in
      [yY])
        chinachu_updater_main && return 0
        ;;
      [nN])
        echo "Abort." && return 0
        ;;
    esac
  done
}

chinachu_updater_main () {
  if [ -e "/etc/init.d/chinachu-operator" ] && [ -e "/etc/init.d/chinachu-wui" ]; then
    while [ 1 ]; do
      echo -n "Do you want to stop chinachu services [Y/n]? "
      read line
      case ${line:-y} in
        [yY])
          if type sudo > /dev/null 2>&1; then
            sudo /etc/init.d/chinachu-operator stop
            sudo /etc/init.d/chinachu-wui stop
            break
          fi
          su -c "/etc/init.d/chinachu-operator stop; /etc/init.d/chinachu-wui stop"
          break
          ;;
        [nN])
          break
          ;;
      esac
    done
  fi

  git pull || fail "failed: git pull"
  git gc

  while [ 1 ]; do
    echo -n "Do you want to run chinachu installer (full) [Y/n]? "
    read line
    case ${line:-y} in
      [yY])
        echo 1 | ./chinachu installer
        break
        ;;
      [nN])
        break
        ;;
    esac
  done

  if [ -e "/etc/init.d/chinachu-operator" ] && [ -e "/etc/init.d/chinachu-wui" ]; then
    while [ 1 ]; do
      echo -n "Do you want to start chinachu services [Y/n]? "
      read line
      case ${line:-y} in
        [yY])
          if type sudo > /dev/null 2>&1; then
            sudo /etc/init.d/chinachu-operator start
            sudo /etc/init.d/chinachu-wui start
            break
          fi
          sudo -c "/etc/init.d/chinachu-operator start; /etc/init.d/chinachu-wui start"
          break
          ;;
        [nN])
          break
          ;;
      esac
    done
  fi
}

chinachu_service () {
  if [ "$1" = "setup" ]; then
    . "$CHINACHU_DIR/lib/service-setup.sh" || return 1
    shift
    chinachu_service_setup "$@"
    return $?
  fi

  local cmd name action
  name="$1"
  action="$2"
  case $action in
    initscript | execute )
      case $name in
        operator | wui )
          cmd="chinachu_service_$action"
          ;;
        * )
          cmd="chinachu_service_help"
          ;;
      esac
      ;;
    * )
      cmd="chinachu_service_help"
      ;;
  esac
  $cmd "$name" && return 0
}

chinachu_service_initscript () {
  local name="$1"

  cat <<EOF
#!/bin/bash
# /etc/

### BEGIN INIT INFO
# Provides:          chinachu-${name}
# Required-Start:    \$local_fs \$remote_fs \$network \$syslog
# Required-Stop:     \$local_fs \$remote_fs \$network \$syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: starts the chinachu-${name}
# Description:       starts the chinachu-${name} (USER=$USER)
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=${CHINACHU_DIR}/chinachu
DAEMON_OPTS="service ${name} execute"
NAME=chinachu-${name}
USER=$USER
PIDFILE=/var/run/\${NAME}.pid

test -x \$DAEMON || exit 0

start () {
  echo -n "Starting \${NAME}: "

  if [ -f \$PIDFILE ]; then
    PID=\`cat \$PIDFILE\`
    if [ -z "\`ps axf | grep \${PID} | grep -v grep\`" ]; then
      rm -f \$PIDFILE
    else
      echo "\${NAME} is already running? (pid=\${PID})"
      exit
    fi
  fi

  PID=\$(su \$USER -c "exec \$DAEMON \$DAEMON_OPTS < /dev/null > /dev/null 2>&1 & echo \\\$!")

  if [ -z \$PID ]; then
    echo "Failed!"
    exit
  else
    echo \$PID > \$PIDFILE
  fi

  echo "OK."
}

stop () {
  echo -n "Stopping \${NAME}: "

  if [ -f \$PIDFILE ]; then
    PID=\`cat \$PIDFILE\`
    PGID=\`ps -p \$PID -o pgrp | grep -v PGRP\`
    kill -QUIT -\`echo \$PGID\`
    echo "OK."
    rm -f \$PIDFILE
  else
    echo "\${NAME} is not running? (\${PIDFILE} not found)."
  fi
}

status () {
  if [ -f \$PIDFILE ]; then
    PID=\`cat \$PIDFILE\`
    if [ -z "\`ps axf | grep \${PID} | grep -v grep\`" ]; then
      echo "\${NAME} is dead but \${PIDFILE} exists."
    else
      echo "\${NAME} is running."
    fi
  else
    echo "\${NAME} is NOT running."
  fi
}

case "\$1" in
  start )
    start "\$@"
    ;;
  stop )
    stop "\$@"
    ;;
  restart )
    stop "\$@"
    sleep 3
    start "\$@"
    ;;
  status )
    status "\$@"
    ;;
  *)
    echo "Usage: \$NAME {start|stop|restart|status}" >&2
    exit 1
    ;;
esac

exit 0

EOF

  return 0
}

chinachu_service_execute () {
  local name="$1"

  chinachu_runtime_bootstrap || return 1

  node app-${name}.js > /dev/stdout 2>&1 | tee -a ./log/${name}
  return ${PIPESTATUS[0]}
}

